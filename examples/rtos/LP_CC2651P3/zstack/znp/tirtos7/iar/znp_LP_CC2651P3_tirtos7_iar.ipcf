        <define>TIMAC_ROM_PATCH</define>
        <define>CUI_DISABLE</define>
        <define>MAX_STATUS_LINES=10</define>
        <define>ZSTACK_SECURITY</define>
        <define>FREQ_2_4G</define>
        <define>OSAL_PORT2TIRTOS</define>
        <define>OSAL_PORT2TIRTOS_OSALMAP</define>

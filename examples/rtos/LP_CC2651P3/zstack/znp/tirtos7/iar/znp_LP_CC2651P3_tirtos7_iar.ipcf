    <extraOptions>
        <args>
            <arg>-f$PROJ_DIR$/ti_utils_build_compiler.opt</arg>
            <arg>-f$PROJ_DIR$/Stack/Config/znp_cnf.opts</arg>
            <arg>--debug</arg>
            <arg>--silent</arg>
            <arg>-e</arg>
            <arg>--aeabi</arg>
            <arg>--thumb</arg>
            <arg>--diag_suppress=Pa050</arg>
            <arg></arg>
            <arg> -DTIRTOS7_SUPPORT</arg>
            <arg> -DHEAPMGR_CONFIG=0x80</arg>
            <arg> -DHEAPMGR_SIZE=0x00</arg>
            <arg> -I$SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR$/kernel/tirtos7/packages</arg>
            <arg> -I$SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR$/source/ti/posix/iar</arg>
        </args>
    </extraOptions>

    <linkerFile>
        <override>true</override>
        <path>$SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR$/source/ti/zstack/boards/cc13x1_cc26x1/cc13x1_cc26x1.icf</path>
    </linkerFile>

    <linkerExtraOptions>
        <args>
            <arg>--silent</arg>
            <arg>--redirect</arg>
            <arg>_Printf=_PrintfSmall</arg>
            <arg>--config_def=NVOCMP_NVPAGES=2</arg>
            <arg> -f$PROJ_DIR$/ti_utils_build_linker.cmd.genlibs</arg>
            <arg> -L$SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR$/source</arg>
            <arg></arg>
            <arg>-L$SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR$/kernel/tirtos7/packages</arg>
            <arg>-f$PROJ_DIR$/ti_utils_build_linker.cmd.genlibs</arg>
            <arg> $SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR$/source/ti/devices/cc13x1_cc26x1/driverlib/bin/iar/driverlib.lib</arg>
        </args>
    </linkerExtraOptions>

    <customBuildTools>
        <customBuildTool atRoot="true" name="SysConfig"> <!-- Custom build tool for entire project-->
            <fileExtensions>.syscfg</fileExtensions>
            <command>$SYSCONFIG_ROOT$/sysconfig_cli.bat -o $PROJ_DIR$ -s "$SIMPLELINK_CC13XX_CC26XX_SDK_INSTALL_DIR$/.metadata/product.json" --compiler iar $FILE_PATH$</command>
            <output>
                <path>SysConfig_Generated_Files.ipcf</path>
            </output>
            <hasPrio>true</hasPrio> <!-- true: run this tool before all other tools-->
        </customBuildTool>
    </customBuildTools>

    <heaps>
        <heap> <!-- If omitted, id="0" -->
            <size>0</size>
        </heap>
        <heap id="1">
            <size>0</size>
        </heap>
    </heaps>
